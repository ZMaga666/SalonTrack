@model List<SalonTrack.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "İstifadəçilər";
    var status = ViewBag.Status as string ?? "active";

    var filteredUsers = status switch
    {
        "deactive" => Model.Where(u => u.IsDeleted),
        "all" => Model,
        _ => Model.Where(u => !u.IsDeleted)
    };
}

<h2>👤 İstifadəçilər</h2>

<a asp-action="Create" class="btn btn-primary mb-3">➕ Yeni İstifadəçi</a>

<form method="get" class="row g-3 mb-3">
    <div class="col-auto">
        <label>Başlanğıc Tarix</label>
        <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate" />
    </div>
    <div class="col-auto">
        <label>Bitmə Tarix</label>
        <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate" />
    </div>
    <div class="col-auto">
        <label>Status</label>
        <select name="status" class="form-select">
            <option value="active" selected="@(status == "active")">Aktiv</option>
            <option value="deactive" selected="@(status == "deactive")">Deaktiv</option>
            <option value="all" selected="@(status == "all")">Hamısı</option>

        </select>
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-success">Filterlə</button>
    </div>
</form>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered table-striped shadow">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>İstifadəçi Adı</th>
            <th>Rolu</th>
            <th>Qeydiyyat Tarixi</th>
            <th>Toplam Gəlir</th>
            <th>Əməliyyat</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in filteredUsers)
        {
            <tr>
                <td>@Model.IndexOf(user) + 1</td>
                <td>@user.UserName</td>
                <td>@user.Role</td>
                <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>@user.TotalIncome.ToString("0.00") ₼</td>
                <td>
                    <a class="btn btn-warning btn-sm" href="/User/Edit/@user.Id">🛠️</a>

                    @if (!user.IsDeleted)
                    {
                        <button class="btn btn-danger btn-sm" onclick="confirmDelete('@user.UserName', '@user.Id')">❌ Sil</button>
                    }
                    else
                    {
                        <form method="post" asp-action="Activate" asp-route-id="@user.Id" style="display:inline;">
                            <button class="btn btn-success btn-sm">✔ Aktiv Et</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function confirmDelete(username, id) {
        Swal.fire({
            title: `Əminsiniz?`,
            text: `"${username}" adlı istifadəçi silinəcək!`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Bəli, sil',
            cancelButtonText: 'İmtina'
        }).then((result) => {
            if (result.isConfirmed) {
                const form = document.createElement('form');
                form.method = 'post';
                form.action = '/User/Delete';

                const hiddenField = document.createElement('input');
                hiddenField.type = 'hidden';
                hiddenField.name = 'id';
                hiddenField.value = id;

                form.appendChild(hiddenField);
                document.body.appendChild(form);
                form.submit();
            }
        });
    }
</script>
